# Server
PORT=6000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/groute?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-jwt-secret-here

# Salesforce
SF_URL=https://login.salesforce.com
SF_USERNAME=your-salesforce-username
SF_PASSWORD=your-salesforce-password
SF_NOTIFICATION_URL=https://your-salesforce-notification-url
SF_INSTANCE_URL=https://your-instance.my.salesforce.com

# Google Maps (used at client build time via REACT_APP_ prefix)
REACT_APP_GOOGLE_MAPS_APIKEY=your-google-maps-api-key
